# Safe disconnected mode. See docs/self-hosting.md before enabling live control.
APP_ORIGIN=http://localhost:3000
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# TOKEN_ENCRYPTION_KEY= # Base64-encoded 32 random bytes, generated locally
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_DEVICE_ACCESS_PROJECT_ID=
# GOOGLE_DEVICE_ID=
TEMPERATURE_MIN_C=10
TEMPERATURE_MAX_C=30
TEMPERATURE_MIN_GAP_C=1.5
# For production, secret files are preferable to direct environment values.
# TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/token_encryption_key
# GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_client_secret
