# Your code (12+ characters, keep it private) and the code you give the other person.
ADMIN_CODE=
USER_CODE=

# Google (see docs/google-setup.md). Run `npm run google-auth` to fill in the last two.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVICE_ACCESS_PROJECT_ID=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DEVICE_ID=

# Allowed temperatures in °C (the admin panel can narrow these for the user).
TEMPERATURE_MIN_C=10
TEMPERATURE_MAX_C=30
TEMPERATURE_MIN_GAP_C=1.5

# Local only. On Netlify the site address is detected automatically.
APP_ORIGIN=http://localhost:3000
PORT=3000
