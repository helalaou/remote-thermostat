{
  "name": "neighbor-thermostat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Share one Nest thermostat, not your Google Home.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "admin": "node --env-file-if-exists=.env src/admin.ts"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "@hono/node-server": "^1.19.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
