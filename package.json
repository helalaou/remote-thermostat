{
  "name": "remote-thermostat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control a Nest thermostat remotely and share access with one person.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "google-auth": "node --env-file=.env scripts/google-auth.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@netlify/blobs": "^11.1.7",
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
